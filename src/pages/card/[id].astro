---
import Layout from '../../layouts/Layout.astro';
import genesis from '../../data/genesis.json';
import sow from '../../data/sow.json';

export function getStaticPaths() {
  const all = [...genesis, ...sow];
  return all.map(c => ({ params: { id: c.id }, props: { card: c } }));
}

const { card } = Astro.props;
const seriesLabel = card.series === 'genesis' ? 'COSMICRAFTS · GENESIS' : 'SHADOWS OF WAR · COMMANDERS';
const collectionHref = card.series === 'genesis' ? '/collections/genesis/' : '/collections/sow/';
const collectionAnchor = card.series === 'genesis' ? 'COSMICRAFTS Genesis Collection' : 'Shadows of War Commanders';
const pool = (card.series === 'genesis' ? genesis : sow).slice().sort((a, b) => (a.num ?? 0) - (b.num ?? 0));
const idx = Math.max(0, pool.findIndex((c) => c.id === card.id));
const siblings = [pool[idx + 1], pool[idx + 2], pool[idx - 1]].filter((c) => c && c.id !== card.id).slice(0, 3);
const tagline = card.title || card.role || card.civ || '';
const attrs = card.series === 'genesis'
  ? [['Faction', card.faction], ['Role', card.role], ['Type', card.type]]
  : [['Civilization', card.civ], ['Role', card.role]];
---

<Layout title={`${card.name} — #${card.serial}/${card.edition} · NFTROPOLY`}>
  <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-6 py-8">

    <a href="/" class="inline-flex items-center gap-2 text-sm text-muted hover:text-cy transition mb-6">
      ← Back to the wall
    </a>

    <div class="flex flex-col lg:flex-row gap-10">

      <!-- art -->
      <div class="lg:w-1/2 flex justify-center">
        <div class={`rc-${card.rarity} card-frame w-full max-w-md aspect-[3/4] rounded-2xl bg-surface overflow-hidden relative`}>
          <img src={card.image} alt={card.name} class="w-full h-full object-cover" />
          <div class="absolute top-3 left-3 chip rc-{card.rarity} font-mono2 text-[11px] tracking-widest px-2.5 py-1 rounded">
            {card.rarity.toUpperCase()}
          </div>
          <div class="absolute top-3 right-3 font-mono2 text-[11px] text-zinc-200 bg-black/60 px-2.5 py-1 rounded">
            #{card.serial} / {card.edition}
          </div>
        </div>
      </div>

      <!-- info -->
      <div class="lg:w-1/2 flex flex-col">
        <div class="font-mono2 text-xs tracking-[0.3em] text-cy">{seriesLabel}</div>
        <h1 class="text-4xl md:text-5xl font-black text-ink mt-2">{card.name}</h1>
        {tagline && <div class="text-lg text-mg mt-1 font-semibold">{tagline}</div>}

        <p class="text-muted mt-5 leading-relaxed">{card.description}</p>

        <!-- attributes -->
        <div class="mt-6 grid grid-cols-2 gap-3">
          {attrs.map(([k, v]) => (
            <div class="rounded-lg border border-line bg-ink/5 px-4 py-3">
              <div class="text-[10px] font-mono2 tracking-widest text-muted uppercase">{k}</div>
              <div class="text-sm text-ink mt-0.5">{v || '—'}</div>
            </div>
          ))}
          <div class="rounded-lg border border-line bg-ink/5 px-4 py-3">
            <div class="text-[10px] font-mono2 tracking-widest text-muted uppercase">Claimed</div>
            <div class="text-sm text-ink mt-0.5" id="supply-line">…</div>
          </div>
          <div class="rounded-lg border border-line bg-ink/5 px-4 py-3">
            <div class="text-[10px] font-mono2 tracking-widest text-muted uppercase">Set</div>
            <div class="text-sm text-ink mt-0.5">{card.series === 'genesis' ? 'Genesis Collection' : 'Commanders'}</div>
          </div>
        </div>

        <!-- ownership -->
        <div class="mt-6 rounded-lg border border-line bg-ink/5 p-4">
          <div class="flex items-center justify-between text-sm">
            <span class="text-ink">You own</span>
            <span class="font-mono2 text-cy" id="owned-line">0</span>
          </div>
          <div class="text-[11px] text-muted mt-2" id="owned-ids"></div>
        </div>

        <!-- actions -->
        <div class="mt-6 flex flex-wrap gap-3">
          <button id="collect-btn"
            class="px-6 py-2.5 rounded-lg bg-cy/15 text-cy border border-cy/40 hover:bg-cy/25 transition font-semibold">
            Claim
          </button>
          <a href="/trades"
            class="px-6 py-2.5 rounded-lg border border-line text-ink hover:bg-ink/5 transition">
            Trade
          </a>
        </div>
        <div id="claim-msg" class="mt-3 text-sm hidden"></div>

        <!-- provenance -->
        <details class="mt-6 rounded-lg border border-line bg-ink/5 p-4 text-sm">
          <summary class="cursor-pointer text-ink font-semibold">Provenance</summary>
          <div id="provenance" class="mt-2 text-xs text-muted">No registered copies owned.</div>
        </details>

        <div class="mt-8 font-mono2 text-[10px] tracking-widest text-muted">
          NFTROPOLY · TRADABLE DIGITAL COLLECTIBLE · {card.id.toUpperCase()}
        </div>

        <nav aria-label="Collection" class="mt-6 rounded-lg border border-line bg-ink/5 p-4 text-sm">
          <a href={collectionHref} class="text-cy font-semibold hover:underline">{collectionAnchor}</a>
          {siblings.length > 0 && (
            <div class="mt-2 text-muted">
              More in this set:{' '}
              {siblings.map((s, i) => (
                <span>
                  {i > 0 && ' · '}
                  <a href={`/card/${s.id}/`} class="text-ink hover:text-cy hover:underline">{s.name}</a>
                </span>
              ))}
            </div>
          )}
          {card.series === 'sow' && (
            <div class="mt-2">
              <a href="https://shadowsofwar.io/leaders/" class="text-muted hover:text-cy hover:underline">Meet the commanders in Shadows of War</a>
            </div>
          )}
        </nav>
      </div>
    </div>
  </div>

  <script define:vars={{ CARD_ID: card.id, CARD_SERIES: card.series }}>
    import { collection } from '../../scripts/collection';
    const API = 'https://id.worldofunreal.com';
    const btn = document.getElementById('collect-btn')!;
    const msg = document.getElementById('claim-msg')!;

    const render = () => {
      const owned = collection.list().filter(a => a.token === CARD_ID);
      document.getElementById('owned-line')!.textContent = `${owned.length}`;
      document.getElementById('owned-ids')!.textContent = owned.length
        ? owned.map(a => `${a.id}${a.status !== 'active' ? ' (frozen)' : ''}`).join(' · ')
        : 'Sign in and claim a serial to own this design.';
      if (owned.length) {
        btn.textContent = 'Claim another serial';
      } else {
        btn.textContent = 'Claim';
      }
      const prov = document.getElementById('provenance')!;
      if (owned.length) {
        Promise.all(owned.map(async (a) => {
          try {
            const r = await fetch(`${API}/api/v1/assets/${encodeURIComponent(a.id)}/events`);
            const evs = r.ok ? await r.json() : [];
            return `<div class="mt-2"><span class="font-mono2 text-cy">${a.id}</span>${evs.map((e: any) => `<div>${e.kind}${e.from ? ` ${e.from.slice(0, 8)} →` : ''}${e.to ? ` ${e.to.slice(0, 8)}` : ''}</div>`).join('')}</div>`;
          } catch { return ''; }
        })).then(html => { prov.innerHTML = html.join('') || 'No events.'; });
      } else {
        prov.textContent = 'No registered copies owned.';
      }
    };
    btn.addEventListener('click', async () => {
      msg.classList.add('hidden');
      try {
        const asset = await collection.claim(CARD_ID);
        msg.textContent = `Claimed ${asset.id}`;
        msg.className = 'mt-3 text-sm text-emerald-400';
      } catch (e: any) {
        msg.textContent = e.message;
        msg.className = 'mt-3 text-sm text-red-400';
      }
      msg.classList.remove('hidden');
    });
    window.addEventListener('nftropoly:collection-changed', render);
    render();

    // Registered supply from the server (replaces catalog decoration).
    (async () => {
      try {
        const r = await fetch(`${API}/api/v1/assets/collections/${CARD_SERIES}/tokens`);
        const toks = r.ok ? await r.json() : [];
        const t = toks.find((x: any) => x.id === CARD_ID);
        document.getElementById('supply-line')!.textContent = t
          ? `${t.minted} / ${t.max_supply} claimed`
          : 'Not registered yet';
      } catch {
        document.getElementById('supply-line')!.textContent = 'Not registered yet';
      }
    })();
  </script>
</Layout>
