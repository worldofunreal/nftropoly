---
import Layout from '../layouts/Layout.astro';
import { catalog } from '../scripts/catalog';

const { series } = await catalog();
---

<Layout title="My Collection — NFTROPOLY">
  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 py-8 md:py-12">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <div class="font-mono2 text-xs tracking-[0.3em] text-mg">YOUR VAULT</div>
        <h1 class="text-4xl md:text-5xl font-black text-ink mt-2">My Collection</h1>
        <p id="id-status" class="text-muted mt-3 text-sm">
          Browsing as guest. <button id="me-signin" class="text-cy hover:underline">Sign in</button> to keep your collection across devices.
        </p>
      </div>
      <div id="vault-stats" class="flex gap-3 font-mono2 text-xs">
        <div class="rounded-lg border border-line bg-surface px-4 py-3 text-center">
          <div id="stat-total" class="text-xl font-bold text-ink">0</div>
          <div class="text-muted mt-0.5">OWNED</div>
        </div>
        <div id="stat-cells" class="contents"></div>
      </div>
    </div>

    <!-- set progress -->
    <div id="set-progress" class="grid md:grid-cols-2 gap-4 mb-8 hidden"></div>

    <!-- owned grid -->
    <div id="owned-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 md:gap-4"></div>

    <!-- empty state -->
    <div id="empty-state" class="text-center py-16">
      <div class="font-mono2 text-xs tracking-[0.3em] text-muted">EMPTY VAULT</div>
      <p class="text-muted mt-3 max-w-md mx-auto text-sm">
        You don't own any collectibles yet. Open a pack from the live drop or browse the collections to start your set.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/#drop" class="px-6 py-2.5 rounded-lg bg-cy/15 text-cy border border-cy/40 hover:bg-cy/25 text-sm font-semibold">Open a pack</a>
        <a href="/#collections" class="px-6 py-2.5 rounded-lg border border-line text-ink hover:bg-ink/5 text-sm">Browse collections</a>
      </div>
    </div>
  </div>

  <script define:vars={{ SERIES: series }}>
    import { collection } from '../scripts/collection';
    import { catalog } from '../scripts/catalog';
    import { wouAuth } from '@worldofunreal/id';
    wouAuth.setDefaultContext('nftropoly');

    const esc = (s) => (s ?? '').toString().replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const grid = document.getElementById('owned-grid')!;
    const empty = document.getElementById('empty-state')!;

    // Token images and totals come from WOU-ID (instance snapshots can be stale).
    const TOK_IMG: Record<string, string> = {};
    const catalogTotals: Record<string, number> = {};

    const render = () => {
      const owned = collection.list();
      const labelOf = (id: string) => (SERIES.find(s => s.id === id)?.symbol ?? id).toUpperCase();
      const signedIn = !!wouAuth.getUser();

      // No tableros de ceros para quien no es nadie: solo el aviso de login.
      document.getElementById('vault-stats')!.style.display = signedIn ? '' : 'none';
      document.getElementById('set-progress')!.classList.toggle('hidden', !signedIn);
      if (!signedIn) { empty.style.display = ''; }

      document.getElementById('stat-total')!.textContent = String(owned.length);
      document.getElementById('stat-cells')!.innerHTML = SERIES.map(s => {
        const total = catalogTotals[s.id] ?? 0;
        const n = owned.filter(a => a.collection === s.id).length;
        return `<div class="rounded-lg border border-line bg-surface px-4 py-3 text-center">
          <div class="text-xl font-bold text-ink">${n}/${total}</div><div class="text-muted mt-0.5">${esc(s.symbol)}</div>
        </div>`;
      }).join('');

      document.getElementById('set-progress')!.innerHTML = SERIES.map(s => {
        const total = catalogTotals[s.id] ?? 0;
        const n = owned.filter(a => a.collection === s.id).length;
        const pct = total ? Math.round((n / total) * 100) : 0;
        return `<div class="rounded-lg border border-line bg-surface p-4">
          <div class="flex justify-between text-sm"><span class="text-ink">${esc(s.name)}</span><span class="font-mono2 text-cy">${pct}%</span></div>
          <div class="mt-2 h-1.5 rounded-full bg-ink/10 overflow-hidden"><div class="h-full bg-gradient-to-r from-cy to-mg transition-all" style="width:${pct}%"></div></div>
        </div>`;
      }).join('');

      empty.style.display = owned.length ? 'none' : '';
      grid.innerHTML = owned.map(a => {
        const img = TOK_IMG[a.token] || a.metadata.image;
        return `
        <a href="/card/${a.token}" class="block rounded-xl bg-surface border border-line overflow-hidden hover:border-cy/30">
          <div class="relative aspect-[3/4] overflow-hidden bg-black">
            ${img ? `<img src="${img}" alt="${esc(a.metadata.name)}" loading="lazy" class="w-full h-full object-cover" />` : ''}
            <div class="absolute top-2 left-2 font-mono2 text-[10px] text-zinc-300/80 bg-black/50 px-2 py-0.5 rounded">#${a.serial}</div>
            ${a.status !== 'active' ? `<div class="absolute top-2 right-2 font-mono2 text-[10px] text-amber-300 bg-black/60 px-2 py-0.5 rounded">FROZEN</div>` : ''}
          </div>
          <div class="p-3">
            <div class="text-[9px] font-mono2 tracking-[0.2em] text-cy/70">${esc(labelOf(a.collection))}</div>
            <div class="text-sm font-bold text-ink mt-0.5 truncate">${esc(a.metadata.name)}</div>
            <div class="text-[10px] font-mono2 text-muted mt-0.5">${esc(a.id)}</div>
          </div>
        </a>`;
      }).join('');

      const u = wouAuth.getUser();
      document.getElementById('id-status')!.innerHTML = u
        ? `Signed in as <span class="text-cy font-semibold">${esc(u.display_name)}</span>${u.email ? ` · ${esc(u.email)}` : ''} — registered copies in WOU-ID.`
        : `Browsing as guest. <button id="me-signin" class="text-cy hover:underline">Sign in</button> to claim and keep copies.`;
      document.getElementById('me-signin')?.addEventListener('click', () => wouAuth.openModal());
    };

    (async () => {
      const { cards } = await catalog();
      for (const c of cards) {
        if (c.image) TOK_IMG[c.id] = c.image;
        catalogTotals[c.series] = (catalogTotals[c.series] ?? 0) + 1;
      }
      render();
    })();

    window.addEventListener('nftropoly:collection-changed', render);
    window.addEventListener('wou:auth-changed', render);
    render();
  </script>
</Layout>
