---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms | NFTropoly">
  <main class="max-w-3xl mx-auto px-6 py-24 text-zinc-300 text-sm leading-relaxed">
    <p class="text-[11px] font-mono text-zinc-500 tracking-widest">LEGAL</p>
    <h1 class="text-4xl font-black text-white tracking-tight mt-2 mb-4">Terms</h1>
    <p>
      Using NFTropoly means accepting the canonical terms at
      <a class="underline" href="https://worldofunreal.com/terms">worldofunreal.com/terms</a>.
      13 and older; 13–17 with a parent/guardian's permission.
    </p>
    <p class="mt-4">
      Collectibles and marketplace assets are digital gameplay items with no monetary value and may
      change for balance, operation, or legal reasons.
    </p>
  </main>
</Layout>
