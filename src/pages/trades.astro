---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trades — NFTROPOLY">
  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 py-8 md:py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <div class="font-mono2 text-xs tracking-[0.3em] text-mg">CARD-FOR-CARD</div>
        <h1 class="text-4xl font-black text-ink mt-1">Trades</h1>
        <p class="text-muted text-sm mt-2">Offer a card for a card — collectors trade, traders flip.</p>
      </div>
      <button id="new-trade-btn" class="px-5 py-2.5 rounded-lg bg-cy/15 text-cy border border-cy/40 font-semibold text-sm">New Trade</button>
    </div>

    <!-- New trade form (hidden) -->
    <div id="trade-form" class="hidden rounded-2xl border border-line bg-surface p-6 mb-8">
      <h3 class="font-bold text-ink">Create Trade Offer</h3>
      <p class="text-xs text-muted mt-1">Sign in to trade. You must own offered cards.</p>
      <div class="mt-4 grid md:grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-mono2 tracking-widest text-muted">OFFERED (comma separated card ids)</label>
          <input id="trade-offered" placeholder="genesis-042, genesis-101" class="mt-1 w-full px-3 py-2 rounded border border-line bg-bg text-ink text-sm" />
          <div id="owned-hint" class="text-xs text-muted mt-1"></div>
        </div>
        <div>
          <label class="text-xs font-mono2 tracking-widest text-muted">REQUESTED</label>
          <input id="trade-requested" placeholder="sow-leonidas, genesis-005" class="mt-1 w-full px-3 py-2 rounded border border-line bg-bg text-ink text-sm" />
        </div>
      </div>
      <div class="mt-4">
        <label class="text-xs font-mono2 tracking-widest text-muted">TO ACCOUNT (optional, leave empty for open offer)</label>
        <input id="trade-to" placeholder="account id or empty" class="mt-1 w-full px-3 py-2 rounded border border-line bg-bg text-ink text-sm" />
      </div>
      <div class="mt-4 flex gap-3">
        <button id="trade-submit" class="px-5 py-2 rounded bg-cy text-bg font-bold text-sm">Create Offer</button>
        <button id="trade-cancel-form" class="px-5 py-2 rounded border border-line text-ink text-sm">Cancel</button>
      </div>
      <div id="trade-error" class="hidden mt-3 text-sm text-red-400"></div>
      <div id="trade-ok" class="hidden mt-3 text-sm text-emerald-400"></div>
    </div>

    <!-- Trade detail via ?trade= -->
    <div id="trade-detail" class="hidden rounded-2xl border border-cy/30 bg-surface p-6 mb-8"></div>

    <!-- Open trades list -->
    <div id="trades-list" class="grid md:grid-cols-2 gap-4"></div>
    <div id="trades-empty" class="hidden text-center py-12">
      <div class="font-mono2 text-xs tracking-[0.3em] text-muted">NO OPEN TRADES</div>
      <p class="text-muted text-sm mt-2">Be the first to propose a swap.</p>
    </div>
  </div>

  <script>
    const API = 'https://id.worldofunreal.com';
    import { wouAuth } from '../scripts/wou-auth';
    import { collection } from '../scripts/collection';

    const listEl = document.getElementById('trades-list');
    const emptyEl = document.getElementById('trades-empty');
    const formEl = document.getElementById('trade-form');
    const hintEl = document.getElementById('owned-hint');

    async function loadTrades() {
      try {
        const res = await fetch(`${API}/api/v1/inventory/trades`);
        const trades = res.ok ? await res.json() : [];
        if (!trades.length) { emptyEl.classList.remove('hidden'); listEl.innerHTML=''; return; }
        emptyEl.classList.add('hidden');
        listEl.innerHTML = trades.map(t => `
          <a href="/trades/${t.id}" class="block rounded-xl border border-line bg-surface p-5 hover:border-cy/30 transition">
            <div class="flex justify-between text-xs font-mono2 tracking-widest text-muted">
              <span>${t.id.slice(0,8)}</span><span class="text-cy">OPEN</span>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-4 text-sm">
              <div><div class="font-mono2 text-xs text-muted">OFFERED</div><div class="mt-1 flex flex-wrap gap-1">${t.offered.map(c=>`<span class="px-2 py-1 rounded bg-ink/5 border border-line text-xs">${c}</span>`).join('')}</div></div>
              <div><div class="font-mono2 text-xs text-muted">REQUESTED</div><div class="mt-1 flex flex-wrap gap-1">${t.requested.map(c=>`<span class="px-2 py-1 rounded bg-ink/5 border border-line text-xs">${c}</span>`).join('')}</div></div>
            </div>
            <div class="mt-3 text-xs text-muted">From ${t.from_account.slice(0,8)}${t.to_account ? ` → ${t.to_account.slice(0,8)}` : ' (open)'}</div>
          </a>
        `).join('');
      } catch (e) {
        emptyEl.classList.remove('hidden');
      }
    }

    function updateHint() {
      const ids = collection.list();
      hintEl.textContent = ids.length ? `You own ${ids.length}: ${ids.slice(0,6).join(', ')}${ids.length>6?' …':''}` : 'You own nothing yet — collect first';
    }

    document.getElementById('new-trade-btn').addEventListener('click', ()=> {
      if (!wouAuth.getToken()) { wouAuth.openModal(); return; }
      formEl.classList.remove('hidden');
      updateHint();
    });
    document.getElementById('trade-cancel-form').addEventListener('click', ()=> formEl.classList.add('hidden'));

    document.getElementById('trade-submit').addEventListener('click', async ()=> {
      const offered = (document.getElementById('trade-offered') as HTMLInputElement).value.split(',').map(s=>s.trim()).filter(Boolean);
      const requested = (document.getElementById('trade-requested') as HTMLInputElement).value.split(',').map(s=>s.trim()).filter(Boolean);
      const to = (document.getElementById('trade-to') as HTMLInputElement).value.trim() || null;
      const errEl = document.getElementById('trade-error');
      const okEl = document.getElementById('trade-ok');
      errEl.classList.add('hidden'); okEl.classList.add('hidden');
      if (!offered.length || !requested.length) { errEl.textContent='Both offered and requested required'; errEl.classList.remove('hidden'); return; }
      const token = wouAuth.getToken();
      if (!token) { wouAuth.openModal(); return; }
      try {
        const res = await fetch(`${API}/api/v1/inventory/trade`, {
          method:'POST',
          headers:{'Content-Type':'application/json', Authorization:`Bearer ${token}`},
          body: JSON.stringify({ offered, requested, to_account_id: to })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        okEl.textContent = `Offer created: ${data.id} — share /trades/${data.id}`;
        okEl.classList.remove('hidden');
        loadTrades();
      } catch (e:any) {
        errEl.textContent = e.message;
        errEl.classList.remove('hidden');
      }
    });

    // Handle ?trade=<id> detail view (for 404 fallback and direct links)
    const tradeParam = new URLSearchParams(location.search).get('trade');
    if (tradeParam) {
      (async () => {
        const detailEl = document.getElementById('trade-detail');
        try {
          const r = await fetch(`${API}/api/v1/inventory/trade/${tradeParam}`);
          const t = r.ok ? await r.json() : null;
          if (!t) throw new Error('Trade not found');
          detailEl.innerHTML = `
            <div class="flex justify-between text-xs font-mono2 tracking-widest text-muted"><span>${t.id}</span><span class="text-cy">${t.status.toUpperCase()}</span></div>
            <div class="mt-3 grid md:grid-cols-2 gap-4 text-sm">
              <div><div class="font-mono2 text-xs text-muted">OFFERED</div><div class="mt-1 flex flex-wrap gap-1">${t.offered.map(c=>`<span class="px-2 py-1 rounded bg-ink/5 border border-line text-xs">${c}</span>`).join('')}</div></div>
              <div><div class="font-mono2 text-xs text-muted">REQUESTED</div><div class="mt-1 flex flex-wrap gap-1">${t.requested.map(c=>`<span class="px-2 py-1 rounded bg-ink/5 border border-line text-xs">${c}</span>`).join('')}</div></div>
            </div>
            <div class="mt-4 flex gap-3">
              <button id="detail-accept" class="px-5 py-2 rounded bg-cy text-bg font-bold text-sm">Accept</button>
              <a href="/trades" class="px-5 py-2 rounded border border-line text-ink text-sm">Back to list</a>
            </div>
            <div id="detail-msg" class="mt-3 text-sm hidden"></div>
          `;
          detailEl.classList.remove('hidden');
          detailEl.scrollIntoView({ behavior:'smooth' });
          document.getElementById('detail-accept').addEventListener('click', async () => {
            const token = wouAuth.getToken();
            if (!token) { wouAuth.openModal(); return; }
            const r2 = await fetch(`${API}/api/v1/inventory/trade/${t.id}/accept`, { method:'POST', headers:{ Authorization:`Bearer ${token}` }});
            const d2 = await r2.json();
            const msg = document.getElementById('detail-msg');
            if (!r2.ok) { msg.textContent = d2.error; msg.className='mt-3 text-sm text-red-400'; }
            else { msg.textContent = 'Trade accepted — inventories swapped'; msg.className='mt-3 text-sm text-emerald-400'; }
            msg.classList.remove('hidden');
          });
        } catch (e:any) {
          const detailEl = document.getElementById('trade-detail');
          detailEl.innerHTML = `<p class="text-sm text-red-400">${e.message}</p>`;
          detailEl.classList.remove('hidden');
        }
      })();
    }

    window.addEventListener('nftropoly:collection-changed', updateHint);
    loadTrades();
    updateHint();
  </script>
</Layout>
