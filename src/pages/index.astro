---
import Layout from '../layouts/Layout.astro';
import CollectionSummary from '../components/CollectionSummary.astro';
import genesis from '../data/genesis.json';
import sow from '../data/sow.json';

const all = [...genesis, ...sow];
const DROP_END = '2026-08-28T00:00:00Z';
---

<Layout title="NFTROPOLY — Digital Collectibles Store">

  <div class="relative z-10">

    <!-- live drop -->
    <section id="drop" class="max-w-7xl mx-auto px-4 md:px-6 pt-10 md:pt-14">
      <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-[#0b101c] via-[#0a0d14] to-[#140a12] p-6 md:p-10 overflow-hidden relative">
        <div class="glow-pulse absolute -top-24 -right-24 w-96 h-96 rounded-full pointer-events-none"
          style="background: radial-gradient(circle, rgba(255,0,123,0.14) 0%, transparent 65%);"></div>

        <div class="flex flex-col lg:flex-row items-center gap-8">
          <!-- pack -->
          <button id="pack-btn" class="relative shrink-0 group" aria-label="Open pack">
            <div class="pack-art relative w-52 h-72 rounded-xl flex items-center justify-center shadow-[0_0_50px_rgba(44,211,255,0.15)] group-hover:shadow-[0_0_70px_rgba(255,0,123,0.25)]
              transition-all duration-300 group-hover:-translate-y-1 overflow-hidden">
              <div class="absolute inset-0 card-back-grid opacity-30"></div>
              <div class="absolute inset-2 rounded-lg border border-white/10 bg-[#0a0e18]/40"></div>
              <div class="pack-seal absolute top-6 right-6 opacity-70"></div>
              <img src="/logo.svg" alt="" class="relative w-32 opacity-90 group-hover:opacity-100 transition" />
              <div class="absolute bottom-4 inset-x-4 text-center font-mono2 text-[10px] tracking-[0.3em] text-cy/80">
                CLICK TO OPEN • SEALED PACK
              </div>
            </div>
          </button>

          <div class="flex-1 text-center lg:text-left">
            <div class="font-mono2 text-xs tracking-[0.3em] text-mg">LIVE DROP</div>
            <h1 class="text-3xl md:text-5xl font-black text-white mt-2 leading-tight">
              COSMICRAFTS<br />
              <span class="bg-gradient-to-r from-cy to-mg bg-clip-text text-transparent">GENESIS COLLECTION</span>
            </h1>
            <p class="text-zinc-400 mt-4 max-w-xl mx-auto lg:mx-0">
              Tradable digital collectibles from the Cosmicrafts universe. Open a pack,
              grow your set, show your showroom. No wallet, no jargon — your account is your vault.
            </p>
            <div class="mt-6 flex items-center justify-center lg:justify-start gap-4">
              <div class="font-mono2 text-2xl md:text-3xl font-bold text-cy" id="countdown">--:--:--</div>
              <div class="text-left text-[11px] text-zinc-500 leading-tight">
                until drop ends
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- collections -->
    <section id="collections" class="max-w-7xl mx-auto px-4 md:px-6 py-10 md:py-14">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-2xl md:text-3xl font-black text-ink">
          THE <span class="text-cy">COLLECTIONS</span>
        </h2>
        <span class="font-mono2 text-sm text-muted">{all.length} collectibles</span>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <CollectionSummary series="genesis" />
        <CollectionSummary series="sow" />
      </div>
    </section>
  </div>

  <!-- pack opening modal -->
  <div id="pack-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 backdrop-blur-sm">
    <div id="pack-inner" class="flex flex-col items-center gap-6 p-8 max-w-3xl w-full"></div>
  </div>

  <script define:vars={{ CARDS: all, DROP_END }}>
    import { collection } from '../scripts/collection';
    const DROP_END_TS = new Date(DROP_END).getTime();

    // countdown
    const tick = () => {
      const d = Math.max(0, DROP_END_TS - Date.now());
      const h = Math.floor(d / 3.6e6), m = Math.floor(d % 3.6e6 / 6e4), s = Math.floor(d % 6e4 / 1e3);
      document.getElementById('countdown').textContent =
        String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    };
    tick();
    setInterval(tick, 1000);

    // pack opening
    const modal = document.getElementById('pack-modal');
    const inner = document.getElementById('pack-inner');
    const openPack = () => {
      const pool = CARDS.filter(c => c.series === 'genesis');
      const picks = [...pool].sort(() => Math.random() - 0.5).slice(0, 3);
      inner.innerHTML = `
        <div class="font-mono2 text-xs tracking-[0.3em] text-cy">PACK OPENED — COSMICRAFTS GENESIS</div>
        <div class="flex flex-wrap justify-center gap-6">
          ${picks.map((c, i) => `
          <a href="/card/${c.id}" class="pack-card relative w-44 h-64" style="animation-delay:${i * .18}s">
            <div class="pack-flip w-full h-full" data-flip>
              <div class="pack-face card-back card-back-grid rounded-xl border border-white/15 flex items-center justify-center cursor-pointer overflow-hidden">
                <div class="absolute inset-2 rounded-lg border border-white/10"></div>
                <img src="/logo.svg" alt="" class="w-24 opacity-80" />
                <div class="absolute bottom-3 inset-x-0 text-center font-mono2 text-[9px] tracking-[0.25em] text-zinc-500">TAP TO REVEAL</div>
              </div>
              <div class="pack-face pack-face-front rc-${c.rarity} card-frame ${(c.rarity==='Legendary'||c.rarity==='Epic')?'foil':''} rounded-xl bg-[#0a0d14] overflow-hidden">
                <img src="${c.image}" alt="${c.name}" class="w-full h-full object-cover" />
                <div class="absolute top-2 left-2 chip text-[9px] font-mono2 px-1.5 py-0.5 rounded">${c.rarity.toUpperCase()}</div>
              </div>
            </div>
          </a>`).join('')}
        </div>
        <div class="flex gap-3">
          <button id="pack-collect" class="px-6 py-2 rounded bg-cy/15 text-cy border border-cy/40 hover:bg-cy/25 text-sm font-semibold">Collect all</button>
          <button id="pack-close" class="px-6 py-2 rounded border border-white/20 text-sm text-zinc-200 hover:bg-white/5">Close</button>
        </div>`;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      inner.querySelectorAll('[data-flip]').forEach((el, i) =>
        setTimeout(() => el.classList.add('flipped'), 700 + i * 500));
      document.getElementById('pack-close').addEventListener('click', close);
      document.getElementById('pack-collect').addEventListener('click', (ev) => {
        collection.addMany(picks.map(c => c.id));
        const b = ev.target as HTMLButtonElement;
        b.textContent = 'Added to your collection';
        b.disabled = true;
        b.classList.add('opacity-60', 'cursor-default');
      });
    };
    const close = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); };
    document.getElementById('pack-btn').addEventListener('click', openPack);
    modal.addEventListener('click', e => { if (e.target === modal) close(); });
  </script>
</Layout>
