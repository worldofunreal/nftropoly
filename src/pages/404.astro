---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found — NFTROPOLY">
  <div class="relative z-10 max-w-3xl mx-auto px-4 md:px-6 py-16 text-center">
    <div class="font-mono2 text-xs tracking-[0.3em] text-mg">404</div>
    <h1 class="text-4xl font-black text-ink mt-2">Not found</h1>
    <p class="text-muted mt-3">This page does not exist. For showcases, use <code class="px-1.5 py-0.5 rounded bg-surface border border-line">/showcase?id=&lt;account_id&gt;</code> or <code class="px-1.5 py-0.5 rounded bg-surface border border-line">/u/&lt;id&gt;</code> via showcase.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="px-6 py-2.5 rounded-lg bg-cy/15 text-cy border border-cy/40 font-semibold">Back to store</a>
      <a href="/showcase" class="px-6 py-2.5 rounded-lg border border-line text-ink">Open showcase</a>
    </div>
  </div>
  <script>
    const path = location.pathname;
    const mShow = path.match(/^\/(?:u\/|@)([^\/]+)/);
    if (mShow) location.replace(`/showcase?id=${encodeURIComponent(mShow[1])}`);
    const mTrade = path.match(/^\/trades\/([^\/]+)/);
    if (mTrade) location.replace(`/trades?trade=${encodeURIComponent(mTrade[1])}`);
  </script>
</Layout>
