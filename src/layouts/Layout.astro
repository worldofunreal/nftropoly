---
import '../styles/global.css';
import AuthModal from '../components/AuthModal.astro';
interface Props {
  title?: string;
}
const { title = 'NFTROPOLY — Digital Collectibles' } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="NFTROPOLY — tradable digital collectibles from World of Unreal games. Collect, display and trade cards from Cosmicrafts and Shadows of War." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#05060a" />
  <script is:inline>
    (function () {
      var t = localStorage.getItem('nftropoly-theme');
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      document.documentElement.dataset.theme = t;
      window.__setTheme = function (n) {
        document.documentElement.dataset.theme = n;
        localStorage.setItem('nftropoly-theme', n);
      };
    })();
  </script>
</head>
<body class="bg-bg text-ink antialiased min-h-screen">
  <div class="ambient fixed inset-0 pointer-events-none z-0"
    style="background: radial-gradient(60% 40% at 15% 0%, rgba(44,211,255,0.10) 0%, transparent 60%), radial-gradient(50% 35% at 85% 10%, rgba(255,0,123,0.08) 0%, transparent 60%);">
  </div>

  <!-- shared header -->
  <header class="sticky top-0 z-40 backdrop-blur-md bg-bg/80 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.svg" alt="NFTROPOLY" class="logo-dark h-7 w-auto" />
        <img src="/logo-dark.svg" alt="NFTROPOLY" class="logo-light h-7 w-auto" />
        <span class="hidden sm:inline font-mono2 text-[10px] tracking-[0.25em] text-muted uppercase">
          Digital Collectibles
        </span>
      </a>
      <nav class="flex items-center gap-2 text-sm">
        <a href="/#drop" class="px-3 py-1.5 rounded hover:bg-ink/5">Drop</a>
        <a href="/#collections" class="px-3 py-1.5 rounded hover:bg-ink/5">Collections</a>
        <a href="/showcase" class="px-3 py-1.5 rounded hover:bg-ink/5">Showcase</a>
        <a href="/trades" class="px-3 py-1.5 rounded hover:bg-ink/5">Trades</a>
        <a href="/vault" class="px-3 py-1.5 rounded hover:bg-ink/5">Vault</a>
        <a href="/me" class="px-3 py-1.5 rounded hover:bg-ink/5">My Collection</a>
        <button id="theme-toggle" aria-label="Toggle theme"
          class="p-2 rounded border border-line text-muted hover:text-ink hover:border-ink/30 transition"
          onclick="__setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark')">
          <svg class="icon-sun w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
          <svg class="icon-moon w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>

        <!-- WOU-ID auth -->
        <div class="relative">
          <button id="wou-signin-btn" type="button"
            class="ml-1 px-4 py-1.5 rounded bg-cy/15 text-cy border border-cy/40 hover:bg-cy/25 transition text-sm font-semibold">
            Sign in
          </button>
          <div id="wou-user-pill" class="hidden relative">
            <button id="wou-user-btn" type="button"
              class="flex items-center gap-2 pl-1.5 pr-3 py-1 rounded-full bg-surface border border-cy/40 hover:border-cy/70 text-ink text-xs transition">
              <div id="wou-user-avatar" class="w-6 h-6 rounded-full bg-gradient-to-tr from-cy to-mg flex items-center justify-center text-[10px] font-bold text-white uppercase">U</div>
              <span id="wou-user-name" class="font-medium max-w-[100px] truncate">Player</span>
              <svg class="w-3 h-3 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="wou-user-dropdown" class="hidden absolute right-0 mt-3 w-64 p-3 bg-surface border border-line rounded-2xl shadow-2xl text-ink z-50">
              <div class="px-2 py-1.5 border-b border-line pb-3 mb-2">
                <p class="text-[10px] text-muted font-mono2 uppercase">Connected Player</p>
                <p id="wou-dropdown-name" class="text-sm font-bold text-ink truncate">Player</p>
                <p id="wou-dropdown-email" class="text-xs text-cy truncate mt-0.5"></p>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="text-[10px] font-mono2 px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                    WOU-ID
                  </span>
                </div>
              </div>
              <button id="wou-logout-btn" type="button"
                class="w-full text-left px-3 py-2 text-xs font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-xl transition flex items-center justify-between">
                <span>Log Out</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              </button>
            </div>
          </div>
        </div>
      </nav>
    </div>
  </header>

  <slot />

  <!-- shared footer -->
  <footer class="border-t border-line py-8">
    <div class="max-w-7xl mx-auto px-4 md:px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted">
      <div class="flex items-center gap-2">
        <img src="/logo.svg" alt="NFTROPOLY" class="logo-dark h-5" />
        <img src="/logo-dark.svg" alt="NFTROPOLY" class="logo-light h-5" />
        <span>World of Unreal — digital collectibles for our games.</span>
      </div>
      <div class="font-mono2 tracking-widest">© 2026 WORLD OF UNREAL</div>
    </div>
  </footer>

  <AuthModal />

  <script>
    import { wouAuth } from '@worldofunreal/id-sdk';
    wouAuth.setDefaultContext('nftropoly');

    const signinBtn = document.getElementById('wou-signin-btn');
    const userPill = document.getElementById('wou-user-pill');
    const userBtn = document.getElementById('wou-user-btn');
    const userAvatar = document.getElementById('wou-user-avatar');
    const userName = document.getElementById('wou-user-name');
    const userDropdown = document.getElementById('wou-user-dropdown');
    const dropdownName = document.getElementById('wou-dropdown-name');
    const dropdownEmail = document.getElementById('wou-dropdown-email');
    const logoutBtn = document.getElementById('wou-logout-btn');

    function updateAuthUI(detail: any) {
      if (detail && detail.isAuthenticated && detail.user) {
        signinBtn?.classList.add('hidden');
        userPill?.classList.remove('hidden');
        const name = detail.user.display_name || 'Player';
        if (userName) userName.textContent = name;
        if (dropdownName) dropdownName.textContent = name;
        if (dropdownEmail) dropdownEmail.textContent = detail.user.email || '';
        if (userAvatar) userAvatar.textContent = name.slice(0, 2).toUpperCase();
      } else {
        signinBtn?.classList.remove('hidden');
        userPill?.classList.add('hidden');
        userDropdown?.classList.add('hidden');
      }
    }

    window.addEventListener('wou:auth-changed', (e: any) => updateAuthUI(e.detail));
    if (wouAuth.isAuthenticated()) updateAuthUI({ isAuthenticated: true, user: wouAuth.getUser() });

    signinBtn?.addEventListener('click', () => wouAuth.openModal());
    userBtn?.addEventListener('click', (e) => { e.stopPropagation(); userDropdown?.classList.toggle('hidden'); });
    logoutBtn?.addEventListener('click', () => { wouAuth.logout(); userDropdown?.classList.add('hidden'); });
    document.addEventListener('click', () => userDropdown?.classList.add('hidden'));
  </script>
</body>
</html>
