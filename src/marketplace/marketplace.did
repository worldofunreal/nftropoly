// ICRC-8 Compliant NFT Marketplace Candid Interface

// Core ICRC-8 Types
type Account = record {
  owner : principal;
  subaccount : opt blob;
};

// ICRC-10 Metadata Types
type SupportedStandard = record { url : text; name : text };

// ICRC-8 Metadata Types
type ICRC8Metadata = record { key : text; value : text };

type TokenSpec = record {
  canister : principal;
  symbol : text;
  standards : vec ICRCStandards;
};

type ICRCStandards = variant {
  ICRC1 : opt ICRC1TokenSpecDetail;
  ICRC2 : opt ICRC2TokenSpecDetail;
  ICRC4 : opt ICRC4TokenSpecDetail;
  ICRC7 : opt ICRC7TokenSpecDetail;
  ICRC37 : opt ICRC37TokenSpecDetail;
};

type ICRC1TokenSpecDetail = record {
  amount : nat64;
  fee : opt nat64;
  decimals : nat64;
};

type ICRC2TokenSpecDetail = record {
  amount : nat64;
  approval_fee : opt nat64;
  transfer_from_fee : opt nat64;
  decimals : nat64;
};

type ICRC4TokenSpecDetail = record {
  batch_fee : opt nat;
  decimals : nat64;
};

type ICRC7TokenSpecDetail = record {
  fee : opt TokenSpec;
  token_id : opt nat;
};

type ICRC37TokenSpecDetail = record {
  approval_fee : opt TokenSpec;
  transfer_from_fee : opt TokenSpec;
  token_id : opt nat64;
};

type TokenSpecResult = record {
  canister : principal;
  symbol : text;
  standards : vec ICRCStandards;
  result : nat64;
  sending_account : Account;
  receiving_account : Account;
  ask_id : opt nat64;
};

// Escrow Types
type EscrowRecord = record {
  escrow_type : EscrowType;
  buyer : opt Account;
  seller : Account;
  ask_id : opt nat64;
  lock_to_date : opt nat64;
};

type EscrowType = variant {
  Bid : vec opt TokenSpec;
  Ask : vec opt TokenSpec;
  Settlement : vec opt TokenSpec;
};

// Ask Types
type AskFeature = variant {
  AllowPartial;
  UnsolicitedOffer : Account;
  BuyNow : vec vec BuyNowReq;
  AllowList : vec Account;
  Broker : Account;
  StartDate : nat64;
  Ending : EndingType;
  AskToken : vec opt TokenSpec;
  FeeSchema : text;
  FeeAccounts : vec record { text; TokenSpec; Account };
  BidPaysFees : opt vec text;
  CreatedAt : nat64;
  Memo : blob;
};

type BuyNowReq = record {
  token : TokenSpec;
  amount : nat64;
};

type EndingType = variant {
  Perpetual;
  Date : nat64;
  Timeout : nat64;
};

type AskStatus = record {
  ask_id : nat64;
  original_broker_id : opt Account;
  current_broker_id : opt Account;
  config : vec AskFeature;
  auction_info : opt AuctionInfo;
  settlement : opt SettlementInfo;
  allow_list : opt vec Account;
  participants : vec Account;
  settled_at : opt record { principal; nat };
  status : AskStatusType;
  seller : Account;
};

type AuctionInfo = record {
  token : TokenSpec;
  current_bid_amount : opt nat;
  end_date : opt nat64;
  start_date : opt nat64;
  min_next_bid : opt nat;
  wait_for_quiet_count : opt nat;
  current_escrow : opt EscrowRecord;
};

type SettlementInfo = record {
  bid_tokens : vec opt TokenSpecResult;
  ask_tokens : vec opt TokenSpecResult;
  royalties : vec record { Account; nat; text };
};

type AskStatusType = variant {
  Open;
  Closed;
  PartiallySettled;
  Encumbered : vec EncumbranceDetail;
  NotStarted;
};

type EncumbranceDetail = record {
  spec : EncumbranceSpec;
  expires_at : nat64;
};

type EncumbranceSpec = record {
  tokens : vec TokenSpec;
  trustees : vec principal;
  timeout : nat64;
};

// Bid Types
type BidFeature = variant {
  Broker : Account;
  Escrow : EscrowRecord;
  FeeSchema : text;
  FeeAccount : vec record { text; TokenSpec; Account };
  Amm : AMMParams;
};

type AMMParams = record {
  token_1 : TokenSpec;
  token_2 : TokenSpec;
  max : nat;
  min : nat;
  decimals : nat8;
};

type EngineMatch = record {
  leader : opt principal;
  asks : vec EngineMatchAsk;
};

type EngineMatchAsk = record {
  ask_canister : opt principal;
  ask_id : nat64;
  token : opt vec opt TokenSpec;
};

// Request/Response Types
type ManageAskRequest = variant {
  NewAsk : NewAskRequest;
  EndAsk : nat;
  RefreshOffers : opt Account;
  WithdrawSettlement : EscrowRecord;
  WithdrawEscrow : EscrowRecord;
  RejectOffer : nat;
  DistributeAsk : nat;
  UpdateAmm : AMMUpdate;
  LockAsk : LockAsk;
  Unencumber : nat;
};

type NewAskRequest = record {
  feature : vec opt AskFeature;
};

type ManageBidRequest = variant {
  NewBid : NewBidRequest;
  EngineMatch : EngineMatch;
  WithdrawEscrow : EscrowRecord;
};

type NewBidRequest = record {
  ask_id : nat64;
  feature : vec opt BidFeature;
};

type ManageAskResponse = variant {
  NewAsk : variant { Ok : NewAskResult; Err : GenericError };
  EndAsk : variant { Ok : nat; Err : GenericError };
  RefreshOffers : variant { Ok : RefreshOffersResult; Err : GenericError };
  WithdrawSettlement : variant { Ok : WithdrawResult; Err : GenericError };
  DistributeAsk : variant { Ok : vec DistributionResult; Err : GenericError };
  LockAsk : variant { Ok : vec TokenSpecResult; Err : GenericError };
};

type ManageBidResponse = variant {
  NewBid : variant { Ok : NewBidResult; Err : GenericError };
  EngineMatch : variant { Ok : vec EngineMatchResult; Err : GenericError };
  WithdrawEscrow : variant { Ok : WithdrawResult; Err : GenericError };
};

type NewAskResult = record {
  ask_id : nat64;
  escrow : EscrowRecord;
};

type NewBidResult = record {
  escrow : EscrowRecord;
  result : nat64;
};

type RefreshOffersResult = record {
  records : vec record { blob; opt AskStatus };
  eof : bool;
  count : nat64;
};

type WithdrawResult = record {
  withdraw_result : nat64;
  token_results : vec TokenResult;
};

type TokenResult = record {
  token : TokenSpec;
  result : variant { Ok : nat64; Err : GenericError };
};

type DistributionResult = record {
  token : TokenSpec;
  result : variant { Ok : nat64; Err : GenericError };
};

type EngineMatchResult = record {
  ask_canister : opt principal;
  ask_id : nat64;
  token : opt vec opt TokenSpecResult;
};

type GenericError = record {
  code : nat64;
  message : text;
};

type AMMUpdate = record {
  ask_id : nat64;
  params : AMMParams;
};

type LockAsk = record {
  ask_id : nat64;
  lock_duration : nat64;
  fee : TokenSpec;
};

// Query Types
type BalanceRequest = variant {
  Nfts : opt BalancePagination;
  Tokens;
  Escrow : opt BalancePagination;
  AskSettlements : opt BalancePagination;
  Offers : opt BalancePagination;
};



type BalancePagination = record {
  prev : opt nat;
  take : opt nat;
};

type BalanceResult = variant {
  Nfts : opt BalanceRecords;
  Tokens : opt nat;
  Escrow : BalanceRecords;
  AskSettlements : BalanceRecords;
  Offers : BalanceRecords;
};

type BalanceRecords = record {
  records : vec EscrowRecord;
  count : nat64;
  eof : bool;
};

type AskInfoRequest = variant {
  Active : opt record { opt nat64; opt nat64 };
  History : record { nat64; nat64 };
  Status : nat64;
};

type AskInfoResponse = variant {
  Active : AskInfoRecords;
  History : AskInfoRecords;
  Status : opt AskStatus;
};

type AskInfoRecords = record {
  records : vec opt AskStatus;
  eof : bool;
  count : nat64;
};

// Main Service Interface
service : {
  // ICRC-8 Core Methods
  icrc8_ask : (vec opt ManageAskRequest) -> (vec record { opt ManageAskRequest; opt ManageAskResponse });
  icrc8_bid : (vec opt ManageBidRequest) -> (vec record { opt ManageBidRequest; opt ManageBidResponse });
  icrc8_balance_of : (vec record { Account; opt BalanceRequest }) -> (vec record { Account; vec BalanceResult });
  icrc8_ask_info : (vec opt AskInfoRequest) -> (vec record { opt AskInfoRequest; opt AskInfoResponse });
  icrc8_approved_tokens : () -> (opt vec principal);
  
  // ICRC-10 Metadata (General Standards Support)
  icrc10_supported_standards : () -> (vec SupportedStandard) query;
  
  // ICRC-8 Metadata (Marketplace-Specific Configuration)
  icrc8_metadata : () -> (vec ICRC8Metadata) query;
  
  // General Metadata
  get_metadata : () -> (vec ICRC8Metadata) query;
  
  // Admin Methods (Admin Only)
  admin_withdraw_escrow : (nat64) -> (variant { Ok : EscrowRecord; Err : GenericError });
  admin_get_all_escrows : () -> (variant { Ok : vec record { nat64; EscrowRecord }; Err : GenericError });
  
  // Debug Methods
  get_debug_state : () -> (text) query;
};
